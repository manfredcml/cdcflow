{
  "source": {
    "type": "mongodb",
    "connection_string": "mongodb://localhost:27017/?replicaSet=rs0",
    "database": "demo",
    "collections": ["users", "orders"]
  },
  "sink": {
    "type": "kafka",
    "brokers": "localhost:9092",
    "topic_prefix": "cdc"
  },
  "offset": {
    "type": "sqlite",
    "path": "/tmp/cdc-offsets.db",
    "key": "mongo-kafka"
  }
}
